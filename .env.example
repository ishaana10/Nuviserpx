APP_NAME="Nuvis ERPX"
APP_ENV=production
APP_DEBUG=false
# 0 = web requests never change the database; apply updates with `php bin/migrate.php` (bin/deploy.sh does). Leave unset only on a development machine.
AUTO_MIGRATE=0
# 64 random hex characters. Encrypts stored secrets (tenant SMTP passwords). Generate with: php -r "echo bin2hex(random_bytes(32)),PHP_EOL;"
# Keep it out of Git and back it up separately from the database: without it those secrets cannot be read.
APP_KEY=
# Developer "Git update" screen. Leave 0 on any server with real data; deploy through your release process.
ALLOW_WEB_GIT=0
# Browser origins allowed to call /api/v1 (comma separated, exact match). Empty = none.
API_CORS_ORIGINS=
# Accept ?api_key= in the URL (leaks into logs). Leave 0 and send the X-API-Key header instead.
API_ALLOW_QUERY_KEY=0
APP_URL="http://localhost/nuviserpx/"

DB_SERVER="localhost"
DB_USERNAME="change_me"
DB_PASSWORD="change_me"
DB_NAME="nuviserpx"

# Sessions use PHP's default file handler. Redis is used for caching only.
SESSION_DRIVER=file
SESSION_COOKIE_NAME=NUVISERPXSESSID

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_PREFIX="nuviserpxssid:"

# --- Operations (see docs/DEPLOYMENT.md) ---
# Backups: php bin/backup.php (cron). Keep BACKUP_DIR OUTSIDE the web root.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Encrypts backup files (AES-256). Store it in your password manager as well as here.
BACKUP_PASSPHRASE=
# Copy each backup off the server. {file} is replaced by the path. Example: rclone copy {file} remote:nuvis-backups/
BACKUP_UPLOAD_CMD=
# Health probe: /health.php. With the header X-Health-Token it returns the full checklist.
HEALTH_TOKEN=
# 1 = the health check reports "degraded" when there is no backup in the last 36 hours.
HEALTH_REQUIRE_BACKUP=1
# Comma separated IP addresses that can still use the site during maintenance mode.
MAINTENANCE_ALLOW_IPS=
